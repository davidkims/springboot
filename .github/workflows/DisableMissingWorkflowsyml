name: Disable Missing Workflows

# 매일 UTC 기준 03:00에, 또는 수동 실행으로 동작
on:
  schedule:
    - cron: '0 3 * * *'
  workflow_dispatch:

# 워크플로우 관리 권한 필요
permissions:
  actions: write

jobs:
  disable-missing:
    name: Disable Workflows with Missing Files
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Install jq (if needed)
        run: |
          sudo apt-get update
          sudo apt-get install -y jq

      - name: List all workflows
        run: |
          echo "▶️ Fetching workflows list..."
          gh workflow list --json id,name,path,state > workflows.json

      - name: Disable workflows whose files are missing
        run: |
          echo "▶️ Disabling workflows with no definition file..."
          jq -c '.[]' workflows.json | while read -r wf; do
            id=$(echo "$wf" | jq -r '.id')
            name=$(echo "$wf" | jq -r '.name')
            path=$(echo "$wf" | jq -r '.path')
            # path가 null이거나 실제 파일이 없으면 disable
            if [ "$path" = "null" ] || [ ! -f "$path" ]; then
              echo "— Disabling: $name (ID: $id), path='$path'"
              gh workflow disable "$id"
            fi
          done
